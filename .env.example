# Copy to .env and fill in. .env is gitignored -- it holds camera credentials.
#
# Full RTSP URL of the physical camera, including credentials. docker-compose.yml passes
# this to the pipeline as `--go2rtc-source cam1=<this>` so go2rtc owns the single
# connection to the camera, while the camera's own configured rtsp_url points at
# go2rtc's restream (rtsp://127.0.0.1:8554/cam1). See LIVE_VIEW_AND_CAPTURE_FIXES.md.
CAM1_RTSP_URL=rtsp://user:password@192.168.1.50:554/h264/ch1/main/av_stream
