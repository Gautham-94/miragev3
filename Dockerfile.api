# mirage read API image: python -m mirage.api (FastAPI/uvicorn). Reads the SAME
# SQLite DB (config/mirage.db) and media/cache files the pipeline container writes --
# shares a Docker volume with it (see docker-compose.yml), never talks to it directly
# over the network.
FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY pyproject.toml ./
COPY mirage ./mirage
RUN pip install --no-cache-dir -e .

ENV MIRAGE_CACHE_DIR=/data/cache \
    MIRAGE_BASE_DIR=/data/media \
    MIRAGE_CONFIG_DIR=/data/config \
    PYTHONUNBUFFERED=1

EXPOSE 8000

# --host 0.0.0.0 (NOT the default 127.0.0.1) so the frontend's nginx reverse proxy
# (Dockerfile.frontend, a separate container) can actually reach this one over the
# docker-compose network. --go2rtc-host points at the "pipeline" service's Docker DNS
# hostname (see docker-compose.yml) -- go2rtc itself runs inside the pipeline container,
# not this one, so mirage/api/routers/live.py and onvif.py can no longer assume
# 127.0.0.1 (that fix is what makes this flag meaningful; see mirage/api/app.py's
# go2rtc_host param). --go2rtc-api-port must match the pipeline's go2rtc instance
# (default DEFAULT_API_PORT, mirage/go2rtc/config.py) -- if you change go2rtc's port in
# one container's config, override it here too.
ENTRYPOINT ["python", "-m", "mirage.api", "--host", "0.0.0.0", "--port", "8000", "--go2rtc-host", "pipeline", "--go2rtc-api-port", "1984"]
